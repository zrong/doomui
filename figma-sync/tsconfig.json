{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./source",
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@cocos/creator-types/editor", "@cocos/creator-types/engine"]
  },
  "include": ["source/**/*.ts", "source/**/*.d.ts"],
  "exclude": ["dist", "node_modules", "test"]
}
